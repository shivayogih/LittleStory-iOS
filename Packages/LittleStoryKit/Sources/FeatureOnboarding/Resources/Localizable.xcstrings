            "value": "ಬದಲಾವಣೆಗಳನ್ನು ಉಳಿಸಿ"
          }
        }
      }
    },
    "setup.error_name_empty": {
      "comment": "From Android feature/onboarding/src/main/res `setup_error_name_empty`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter your child’s name."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ದಯವಿಟ್ಟು ನಿಮ್ಮ ಮಗುವಿನ ಹೆಸರನ್ನು ನಮೂದಿಸಿ."
          }
        }
      }
    },
    "setup.error_name_too_long": {
      "comment": "From Android feature/onboarding/src/main/res `setup_error_name_too_long`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names can be up to %1$lld characters."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಹೆಸರು ಗರಿಷ್ಠ %1$lld ಅಕ್ಷರಗಳಷ್ಟಿರಬಹುದು."
          }
        }
      }
    },
