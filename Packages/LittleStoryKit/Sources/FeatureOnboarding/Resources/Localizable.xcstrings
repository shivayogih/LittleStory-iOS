{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "onboarding.body_1": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_body_1`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn school days, family moments and tiny acts of kindness into magical adventures."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಶಾಲೆಯ ದಿನಗಳು, ಕುಟುಂಬದ ಕ್ಷಣಗಳು ಮತ್ತು ಸಣ್ಣ ದಯೆಯ ಕೆಲಸಗಳನ್ನು ಮಾಯಾ ಸಾಹಸಗಳನ್ನಾಗಿ ಮಾಡಿ."
          }
        }
      }
    },
    "onboarding.body_2": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_body_2`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stories shaped around their name, age and favourite things—with parents always in control."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಗುವಿನ ಹೆಸರು, ವಯಸ್ಸು ಮತ್ತು ಇಷ್ಟಗಳ ಸುತ್ತ ರೂಪುಗೊಂಡ ಕಥೆಗಳು—ಪೋಷಕರ ನಿಯಂತ್ರಣದಲ್ಲಿ."
          }
        }
      }
    },
    "onboarding.body_3": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_body_3`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle narration, offline stories and a sleep timer make bedtime feel wonderfully calm."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮೃದುವಾದ ನಿರೂಪಣೆ, ಆಫ್‌ಲೈನ್ ಕಥೆಗಳು ಮತ್ತು ನಿದ್ರಾ ಟೈಮರ್ ಮಲಗುವ ಸಮಯವನ್ನು ಶಾಂತವಾಗಿಸುತ್ತವೆ."
          }
        }
      }
    },
    "onboarding.cta_get_started": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_cta_get_started`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರಾರಂಭಿಸಿ"
          }
        }
      }
    },
    "onboarding.eyebrow": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_eyebrow`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Little Stories. Big Imagination."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪುಟ್ಟ ಕಥೆಗಳು. ದೊಡ್ಡ ಕಲ್ಪನೆ."
          }
        }
      }
    },
    "onboarding.pager_description": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_pager_description`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slide %1$lld of %2$lld"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸ್ಲೈಡ್ %1$lld / %2$lld"
          }
        }
      }
    },
    "onboarding.title_1": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_title_1`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Day Has a Story"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರತಿ ದಿನವೂ ಒಂದು ಕಥೆ"
          }
        }
      }
    },
    "onboarding.title_2": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_title_2`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Child, the Hero"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಮ್ಮ ಮಗು, ನಾಯಕ"
          }
        }
      }
    },
    "onboarding.title_3": {
      "comment": "From Android feature/onboarding/src/main/res `onboarding_title_3`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen, Dream, Repeat"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕೇಳಿ, ಕನಸು ಕಾಣಿ, ಮತ್ತೆ ಕೇಳಿ"
          }
        }
      }
    },
