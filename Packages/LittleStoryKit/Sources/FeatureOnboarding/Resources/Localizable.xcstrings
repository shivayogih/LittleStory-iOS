    "setup.skip": {
      "comment": "From Android feature/onboarding/src/main/res `setup_skip`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip for now"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಈಗ ಬಿಟ್ಟುಬಿಡಿ"
          }
        }
      }
    },
    "setup.subtitle": {
      "comment": "From Android feature/onboarding/src/main/res `setup_subtitle`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few details help us choose safe, age-appropriate adventures."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕೆಲವು ವಿವರಗಳು ಸುರಕ್ಷಿತ, ವಯಸ್ಸಿಗೆ ಸೂಕ್ತವಾದ ಸಾಹಸಗಳನ್ನು ಆಯ್ಕೆ ಮಾಡಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ."
          }
        }
      }
    },
    "setup.title": {
      "comment": "From Android feature/onboarding/src/main/res `setup_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s make stories feel like home."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕಥೆಗಳು ಮನೆಯಂತೆ ಅನಿಸಲಿ."
          }
        }
      }
    }
  }
}
