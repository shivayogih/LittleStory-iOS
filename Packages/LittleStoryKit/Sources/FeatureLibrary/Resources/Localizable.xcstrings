{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "downloads.available": {
      "comment": "From Android feature/library/src/main/res `downloads_available`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AVAILABLE OFFLINE"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಲಭ್ಯ"
          }
        }
      }
    },
    "downloads.empty_action": {
      "comment": "From Android feature/library/src/main/res `downloads_empty_action`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a story"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಒಂದು ಕಥೆ ಹುಡುಕಿ"
          }
        }
      }
    },
    "downloads.empty_text": {
      "comment": "From Android feature/library/src/main/res `downloads_empty_text`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a few favourites for journeys, power cuts and cosy nights away."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರಯಾಣ, ವಿದ್ಯುತ್ ಕಡಿತ ಮತ್ತು ಮನೆಯಿಂದ ದೂರದ ಬೆಚ್ಚಗಿನ ರಾತ್ರಿಗಳಿಗಾಗಿ ಕೆಲವು ಮೆಚ್ಚಿನ ಕಥೆಗಳನ್ನು ಉಳಿಸಿ."
          }
        }
      }
    },
    "downloads.empty_title": {
      "comment": "From Android feature/library/src/main/res `downloads_empty_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No downloads yet"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಇನ್ನೂ ಡೌನ್‌ಲೋಡ್‌ಗಳಿಲ್ಲ"
          }
        }
      }
    },
    "downloads.quota": {
      "comment": "From Android feature/library/src/main/res `downloads_quota`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ GB available for stories"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕಥೆಗಳಿಗೆ %1$@ GB ಲಭ್ಯ"
          }
        }
      }
    },
    "downloads.remove": {
      "comment": "From Android feature/library/src/main/res `downloads_remove`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove download of %1$@"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ಡೌನ್‌ಲೋಡ್ ತೆಗೆದುಹಾಕಿ"
          }
        }
      }
    },
    "downloads.size": {
      "comment": "From Android feature/library/src/main/res `downloads_size`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ MB · Audio & story"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ MB · ಧ್ವನಿ ಮತ್ತು ಕಥೆ"
          }
        }
      }
    },
    "downloads.tip": {
      "comment": "From Android feature/library/src/main/res `downloads_tip`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline means worry-free. Downloaded stories work without internet and stay private on this device."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಫ್‌ಲೈನ್ ಎಂದರೆ ಚಿಂತೆಯಿಲ್ಲ. ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಕಥೆಗಳು ಇಂಟರ್ನೆಟ್ ಇಲ್ಲದೆ ಕೆಲಸ ಮಾಡುತ್ತವೆ ಮತ್ತು ಈ ಸಾಧನದಲ್ಲೇ ಖಾಸಗಿಯಾಗಿರುತ್ತವೆ."
          }
        }
      }
    },
    "downloads.title": {
      "comment": "From Android feature/library/src/main/res `downloads_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline Downloads"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಫ್‌ಲೈನ್ ಡೌನ್‌ಲೋಡ್‌ಗಳು"
          }
        }
      }
    },
    "downloads.used": {
