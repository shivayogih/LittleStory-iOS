        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಕಥೆಗಳನ್ನು ಅನ್ವೇಷಿಸಿ"
          }
        }
      }
    },
    "stories.empty_downloaded_text": {
      "comment": "From Android feature/library/src/main/res `stories_empty_downloaded_text`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a story and bedtime can travel anywhere."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಒಂದು ಕಥೆಯನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ, ಮಲಗುವ ಸಮಯ ಎಲ್ಲಿ ಬೇಕಾದರೂ ಜೊತೆಗಿರುತ್ತದೆ."
          }
        }
      }
    },
    "stories.empty_downloaded_title": {
      "comment": "From Android feature/library/src/main/res `stories_empty_downloaded_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready for offline adventures?"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಆಫ್‌ಲೈನ್ ಸಾಹಸಗಳಿಗೆ ಸಿದ್ಧವೇ?"
          }
        }
      }
    },
    "stories.empty_text": {
      "comment": "From Android feature/library/src/main/res `stories_empty_text`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the heart on a story you love to keep it close."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಮಗೆ ಇಷ್ಟವಾದ ಕಥೆಯ ಹೃದಯವನ್ನು ಒತ್ತಿ, ಅದನ್ನು ಹತ್ತಿರ ಇಟ್ಟುಕೊಳ್ಳಿ."
          }
        }
      }
    },
