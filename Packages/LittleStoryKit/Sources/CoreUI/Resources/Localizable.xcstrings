    "coming_soon.text": {
      "comment": "iOS only. Body of a screen that a later phase builds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of LittleStory is still being built."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "LittleStory ಯ ಈ ಭಾಗವನ್ನು ಇನ್ನೂ ನಿರ್ಮಿಸಲಾಗುತ್ತಿದೆ."
