    "parental.gate_body": {
      "comment": "From Android core/ui/src/main/res `parental_gate_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This part of LittleStory is for parents and guardians. Please answer to continue."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಲಿಟಲ್‌ಸ್ಟೋರಿಯ ಈ ಭಾಗ ಪೋಷಕರು ಮತ್ತು ಪಾಲಕರಿಗಾಗಿ. ಮುಂದುವರಿಯಲು ದಯವಿಟ್ಟು ಉತ್ತರಿಸಿ."
          }
        }
      }
    },
