    "create.intro_body": {
      "comment": "From Android feature/create/src/main/res `create_intro_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us about your child’s day. We’ll turn the little moments into a magical adventure."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಮ್ಮ ಮಗುವಿನ ದಿನದ ಬಗ್ಗೆ ಹೇಳಿ. ಪುಟ್ಟ ಕ್ಷಣಗಳನ್ನು ನಾವು ಮಾಯಾ ಸಾಹಸವನ್ನಾಗಿ ಮಾಡುತ್ತೇವೆ."
          }
        }
      }
    },
