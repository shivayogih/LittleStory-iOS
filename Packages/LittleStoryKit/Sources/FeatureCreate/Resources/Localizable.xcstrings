    "create.safety_note": {
      "comment": "From Android feature/create/src/main/res `create_safety_note`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made safely, just for your family. Your story details stay private and are never shared publicly."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಿಮ್ಮ ಕುಟುಂಬಕ್ಕಾಗಿಯೇ ಸುರಕ್ಷಿತವಾಗಿ ರಚಿಸಲಾಗಿದೆ. ನಿಮ್ಮ ಕಥೆಯ ವಿವರಗಳು ಖಾಸಗಿಯಾಗಿರುತ್ತವೆ, ಎಂದಿಗೂ ಸಾರ್ವಜನಿಕವಾಗಿ ಹಂಚಿಕೊಳ್ಳುವುದಿಲ್ಲ."
          }
        }
      }
    },
