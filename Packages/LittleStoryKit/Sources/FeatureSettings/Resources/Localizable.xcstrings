    "privacy.policy_changes_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_changes_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a future version connects to the internet or uses AI to write stories, we will update this policy first and ask for a parent’s permission before any child’s information leaves the device."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮುಂದಿನ ಆವೃತ್ತಿ ಇಂಟರ್ನೆಟ್‌ಗೆ ಸಂಪರ್ಕಿಸಿದರೆ ಅಥವಾ ಕಥೆ ಬರೆಯಲು AI ಬಳಸಿದರೆ, ಮೊದಲು ಈ ನೀತಿಯನ್ನು ನವೀಕರಿಸುತ್ತೇವೆ; ಯಾವುದೇ ಮಗುವಿನ ಮಾಹಿತಿ ಸಾಧನದಿಂದ ಹೊರಹೋಗುವ ಮೊದಲು ಪೋಷಕರ ಅನುಮತಿ ಕೇಳುತ್ತೇವೆ."
          }
        }
      }
    },
    "privacy.policy_changes_title": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_changes_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this changes"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಇದು ಬದಲಾದರೆ"
          }
        }
      }
    },
    "privacy.policy_children_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_children_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We do not collect personal information from children. The details a parent enters are kept only in the app’s private storage on this device and are never sent to us or to anyone else."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನಾವು ಮಕ್ಕಳಿಂದ ವೈಯಕ್ತಿಕ ಮಾಹಿತಿಯನ್ನು ಸಂಗ್ರಹಿಸುವುದಿಲ್ಲ. ಪೋಷಕರು ನಮೂದಿಸುವ ವಿವರಗಳು ಈ ಸಾಧನದಲ್ಲಿ ಆ್ಯಪ್‌ನ ಖಾಸಗಿ ಸಂಗ್ರಹದಲ್ಲಿ ಮಾತ್ರ ಇರುತ್ತವೆ; ಅವನ್ನು ನಮಗೆ ಅಥವಾ ಬೇರೆ ಯಾರಿಗೂ ಕಳುಹಿಸುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "privacy.policy_children_title": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_children_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
