    "children.add_another_body": {
      "comment": "From Android feature/settings/src/main/res `children_add_another_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalise stories for every little listener"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರತಿ ಪುಟ್ಟ ಕೇಳುಗರಿಗೂ ಕಥೆಗಳನ್ನು ವೈಯಕ್ತೀಕರಿಸಿ"
          }
        }
      }
    },
    "children.age_language": {
      "comment": "From Android feature/settings/src/main/res `children_age_language`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@count@ · %2$@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg year"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg years"
                    }
                  }
                }
              }
            }
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%#@count@ · %2$@"
          },
          "substitutions": {
            "count": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg ವರ್ಷ"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "needs_review",
                      "value": "%arg ವರ್ಷಗಳು"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "children.banner": {
      "comment": "From Android feature/settings/src/main/res `children_banner`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private family profiles. Only you can see and manage your children’s details."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಖಾಸಗಿ ಕುಟುಂಬ ಪ್ರೊಫೈಲ್‌ಗಳು. ನಿಮ್ಮ ಮಕ್ಕಳ ವಿವರಗಳನ್ನು ನೀವು ಮಾತ್ರ ನೋಡಬಹುದು ಮತ್ತು ನಿರ್ವಹಿಸಬಹುದು."
          }
        }
      }
    },
    "children.edit": {
      "comment": "From Android feature/settings/src/main/res `children_edit`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit %1$@’s profile"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ ಅವರ ಪ್ರೊಫೈಲ್ ಬದಲಿಸಿ"
          }
        }
      }
    },
