            "value": "Children’s information"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಕ್ಕಳ ಮಾಹಿತಿ"
          }
        }
      }
    },
    "privacy.policy_contact_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_contact_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
