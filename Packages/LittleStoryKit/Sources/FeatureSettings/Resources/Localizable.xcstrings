    "privacy.policy_keep_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_policy_keep_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you delete it below or uninstall the app. It is left out of cloud backups and transfers to a new device."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನೀವು ಕೆಳಗೆ ಅಳಿಸುವವರೆಗೆ ಅಥವಾ ಆ್ಯಪ್ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡುವವರೆಗೆ. ಇದು ಕ್ಲೌಡ್ ಬ್ಯಾಕಪ್‌ಗೂ ಹೊಸ ಸಾಧನಕ್ಕೆ ವರ್ಗಾವಣೆಗೂ ಸೇರುವುದಿಲ್ಲ."
          }
        }
      }
    },
    "privacy.policy_keep_body_ios": {
      "comment": "iOS only: how long data is kept. iOS includes app data in the device's own backups, so this differs from Android.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you delete it below or delete the app. Like other app data, it can be part of this device’s own iCloud or computer backup, which only you control; it is never sent to us."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನೀವು ಕೆಳಗೆ ಅಳಿಸುವವರೆಗೆ ಅಥವಾ ಆ್ಯಪ್ ಅಳಿಸುವವರೆಗೆ. ಇತರ ಆ್ಯಪ್ ಡೇಟಾದಂತೆ, ಇದು ನಿಮ್ಮ ನಿಯಂತ್ರಣದಲ್ಲಿರುವ ಈ ಸಾಧನದ iCloud ಅಥವಾ ಕಂಪ್ಯೂಟರ್ ಬ್ಯಾಕಪ್‌ನ ಭಾಗವಾಗಿರಬಹುದು; ಇದನ್ನು ಎಂದಿಗೂ ನಮಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ."
