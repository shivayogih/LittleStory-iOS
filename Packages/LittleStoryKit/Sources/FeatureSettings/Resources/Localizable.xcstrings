    "privacy.content_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_content_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library stories are written for young listeners. Stories made on Create are put together on this device from a template, without AI. Please enjoy new stories together with your child."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಸಂಗ್ರಹದ ಕಥೆಗಳನ್ನು ಪುಟ್ಟ ಕೇಳುಗರಿಗಾಗಿ ಬರೆಯಲಾಗಿದೆ. ರಚಿಸಿ ವಿಭಾಗದ ಕಥೆಗಳನ್ನು AI ಇಲ್ಲದೆ, ಮಾದರಿಯಿಂದ ಈ ಸಾಧನದಲ್ಲೇ ಜೋಡಿಸಲಾಗುತ್ತದೆ. ಹೊಸ ಕಥೆಗಳನ್ನು ನಿಮ್ಮ ಮಗುವಿನ ಜೊತೆ ಸೇರಿ ಆನಂದಿಸಿ."
          }
        }
      }
    },
