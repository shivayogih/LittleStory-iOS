    "privacy.confirm_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_confirm_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Profiles, favourites, progress, downloads and created stories will be gone."
