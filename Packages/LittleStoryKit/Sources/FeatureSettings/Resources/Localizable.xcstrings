    "help.licences_body": {
      "comment": "From Android feature/settings/src/main/res `help_licences_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonts: %1$@, under the SIL Open Font License 1.1. Built with Android Jetpack libraries under the Apache License 2.0."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅಕ್ಷರಶೈಲಿಗಳು: %1$@, SIL ಓಪನ್ ಫಾಂಟ್ ಲೈಸೆನ್ಸ್ 1.1 ಅಡಿಯಲ್ಲಿ. Apache ಲೈಸೆನ್ಸ್ 2.0 ಅಡಿಯ Android Jetpack ಲೈಬ್ರರಿಗಳಿಂದ ನಿರ್ಮಿಸಲಾಗಿದೆ."
          }
        }
      }
    },
    "help.licences_body_ios": {
      "comment": "iOS only: Help & about licences; %1$@ is the list of font names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonts: %1$@, under the SIL Open Font License 1.1. Built with Apple’s SwiftUI and the Swift standard libraries."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಅಕ್ಷರಶೈಲಿಗಳು: %1$@, SIL ಓಪನ್ ಫಾಂಟ್ ಲೈಸೆನ್ಸ್ 1.1 ಅಡಿಯಲ್ಲಿ. Apple ನ SwiftUI ಮತ್ತು Swift ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಲೈಬ್ರರಿಗಳಿಂದ ನಿರ್ಮಿಸಲಾಗಿದೆ."
          }
        }
      }
    },
    "help.licences_title": {
      "comment": "From Android feature/settings/src/main/res `help_licences_title`.",
