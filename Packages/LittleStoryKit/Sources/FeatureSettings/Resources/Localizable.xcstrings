    "children.title": {
      "comment": "From Android feature/settings/src/main/res `children_title`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Child Profiles"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಕ್ಕಳ ಪ್ರೊಫೈಲ್‌ಗಳು"
          }
        }
      }
    },
    "help.a_children": {
      "comment": "From Android feature/settings/src/main/res `help_a_children`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile → Manage children → Add a child profile."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರೊಫೈಲ್ → ಮಕ್ಕಳನ್ನು ನಿರ್ವಹಿಸಿ → ಮಗುವಿನ ಪ್ರೊಫೈಲ್ ಸೇರಿಸಿ."
          }
        }
      }
    },
    "help.a_language": {
      "comment": "From Android feature/settings/src/main/res `help_a_language`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile → Language preferences. The app and stories can use different languages."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪ್ರೊಫೈಲ್ → ಭಾಷೆಯ ಆದ್ಯತೆಗಳು. ಆ್ಯಪ್ ಮತ್ತು ಕಥೆಗಳು ಬೇರೆ ಬೇರೆ ಭಾಷೆಗಳನ್ನು ಬಳಸಬಹುದು."
          }
        }
      }
    },
    "help.a_offline": {
      "comment": "From Android feature/settings/src/main/res `help_a_offline`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes. All stories are on the device; downloading only adds a story to the Downloaded tab."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಹೌದು. ಎಲ್ಲಾ ಕಥೆಗಳು ಸಾಧನದಲ್ಲೇ ಇವೆ; ಡೌನ್‌ಲೋಡ್‌ಗಳು ಕೇವಲ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದವು ಟ್ಯಾಬ್‌ಗಾಗಿ ಗುರುತಿಸುತ್ತವೆ."
          }
        }
      }
    },
    "help.a_stories": {
      "comment": "From Android feature/settings/src/main/res `help_a_stories`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us about your child’s day on Create. This version builds the story on the device from a template; narration is simulated."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ರಚಿಸಿ ಪುಟದಲ್ಲಿ ನಿಮ್ಮ ಮಗುವಿನ ದಿನದ ಬಗ್ಗೆ ತಿಳಿಸಿ. ಈ ಆವೃತ್ತಿ ಸಾಧನದಲ್ಲೇ ಮಾದರಿಯಿಂದ ಕಥೆ ರಚಿಸುತ್ತದೆ; ನಿರೂಪಣೆ ಅನುಕರಿಸಿದ್ದು."
          }
        }
      }
    },
    "help.group_about": {
      "comment": "From Android feature/settings/src/main/res `help_group_about`.",
      "extractionState": "manual",
      "localizations": {
