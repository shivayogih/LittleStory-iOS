    "privacy.audience_body": {
      "comment": "From Android feature/settings/src/main/res `privacy_audience_body`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LittleStory is for children aged %1$lld to %2$lld. A parent or guardian sets it up and manages each child’s profile."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಲಿಟಲ್‌ಸ್ಟೋರಿ %1$lld ರಿಂದ %2$lld ವರ್ಷದ ಮಕ್ಕಳಿಗಾಗಿ. ಪೋಷಕರು ಅಥವಾ ಪಾಲಕರು ಇದನ್ನು ಸಿದ್ಧಪಡಿಸಿ, ಪ್ರತಿ ಮಗುವಿನ ಪ್ರೊಫೈಲ್ ನಿರ್ವಹಿಸುತ್ತಾರೆ."
          }
