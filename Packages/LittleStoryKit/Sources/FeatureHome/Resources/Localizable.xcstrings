          "stringUnit": {
            "state": "needs_review",
            "value": "ಕಾಲಾತೀತ ಜ್ಞಾನ, ಕುಟುಂಬ ಸಂಪ್ರದಾಯಗಳು ಮತ್ತು ಸಂತಸದ ಹಬ್ಬಗಳು."
          }
        }
      }
