    "category.all_description": {
      "comment": "From Android feature/discover/src/main/res `category_all_description`.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every story in the library, ready for tonight."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಇಂದು ರಾತ್ರಿಗೆ ಸಿದ್ಧವಾಗಿರುವ ಗ್ರಂಥಾಲಯದ ಎಲ್ಲಾ ಕಥೆಗಳು."
          }
        }
      }
    },
